# ─── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=khetibadi
POSTGRES_PASSWORD=changeme
POSTGRES_DB=khetibadi
DATABASE_URL=postgres://khetibadi:changeme@postgres:5432/khetibadi?sslmode=disable

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Auth Service ─────────────────────────────────────────────────────────────
# Generate secrets with: openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h
HMAC_SECRET=change-me-hmac-secret-min-32-chars
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── Farm Service ─────────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=your-openweathermap-api-key
OPENWEATHERMAP_API_KEY=your-openweathermap-api-key
WEATHER_CACHE_TTL=10800
GEOCODING_PROVIDER=maps.co
MAPS_CO_API_KEY=your-maps-co-api-key

# ─── Market Service ───────────────────────────────────────────────────────────
MARKET_CACHE_TTL=21600
PRICE_CACHE_TTL=21600
AGMARKNET_API_URL=https://agmarknet.gov.in/SearchCmmMkt.aspx
DATA_GOV_IN_API_KEY=your-data-gov-in-api-key
MARKET_DATA_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
MARKET_DATA_API_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070
MARKET_DATA_FORMAT=json
MARKET_DATA_LIMIT=100

# ─── AI Chat ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=2048
AI_CHAT_ALLOW_FAKE_LLM=true

# ─── ML Services ──────────────────────────────────────────────────────────────
ML_ALLOW_STUB_MODE=true

# ─── Workers ──────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=5

# ─── Service URLs (internal Docker network) ───────────────────────────────────
AUTH_SERVICE_URL=http://auth:8000
FARM_SERVICE_URL=http://farm-service:8001
MARKET_SERVICE_URL=http://market-service:8002
ML_CROP_SERVICE_URL=http://ml-crop:8010
ML_VISION_SERVICE_URL=http://ml-vision:8011
AI_CHAT_SERVICE_URL=http://ai-chat:8012
ML_CROP_URL=http://ml-crop:8010
ML_VISION_URL=http://ml-vision:8011
AI_CHAT_URL=http://ai-chat:8012
CHAT_RETENTION_DAYS=90

# ─── Dashboard ────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
