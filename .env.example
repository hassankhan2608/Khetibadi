# ─── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=khetibadi
POSTGRES_PASSWORD=changeme
POSTGRES_DB=khetibadi

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth Service ─────────────────────────────────────────────────────────────
JWT_SECRET=change-me-jwt-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
HMAC_SECRET=change-me-hmac-secret-min-32-chars

# ─── Farm Service ─────────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=your-openweathermap-api-key
WEATHER_CACHE_TTL=10800   # 3 hours in seconds

# ─── Market Service ───────────────────────────────────────────────────────────
MARKET_CACHE_TTL=21600    # 6 hours in seconds

# ─── AI Chat ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key

# ─── Service URLs (used by workers + ai-chat for inter-service HTTP) ──────────
AUTH_SERVICE_URL=http://localhost:8000
FARM_SERVICE_URL=http://localhost:8001
MARKET_SERVICE_URL=http://localhost:8002
ML_CROP_SERVICE_URL=http://localhost:8010
ML_VISION_SERVICE_URL=http://localhost:8011
AI_CHAT_SERVICE_URL=http://localhost:8012

# ─── Dashboard ────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_FARM_API_URL=http://localhost:8001
VITE_MARKET_API_URL=http://localhost:8002
VITE_ML_CROP_API_URL=http://localhost:8010
VITE_ML_VISION_API_URL=http://localhost:8011
VITE_AI_CHAT_API_URL=http://localhost:8012
