# ─── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=khetibadi
POSTGRES_PASSWORD=changeme
POSTGRES_DB=khetibadi
DATABASE_URL=postgres://khetibadi:changeme@localhost:5432/khetibadi?sslmode=disable

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth Service ─────────────────────────────────────────────────────────────
# Generate secrets with: openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h
HMAC_SECRET=change-me-hmac-secret-min-32-chars

# ─── Farm Service ─────────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=your-openweathermap-api-key
OPENWEATHERMAP_API_KEY=your-openweathermap-api-key
WEATHER_CACHE_TTL=10800

# ─── Market Service ───────────────────────────────────────────────────────────
MARKET_CACHE_TTL=21600
PRICE_CACHE_TTL=21600
AGMARKNET_API_URL=https://agmarknet.gov.in/SearchCmmMkt.aspx

# ─── AI Chat ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=2048

# ─── Service URLs (used by workers + ai-chat for inter-service HTTP) ──────────
AUTH_SERVICE_URL=http://localhost:8000
FARM_SERVICE_URL=http://localhost:8001
MARKET_SERVICE_URL=http://localhost:8002
ML_CROP_SERVICE_URL=http://localhost:8010
ML_VISION_SERVICE_URL=http://localhost:8011
AI_CHAT_SERVICE_URL=http://localhost:8012
ML_CROP_URL=http://localhost:8010
ML_VISION_URL=http://localhost:8011
AI_CHAT_URL=http://localhost:8012
CHAT_RETENTION_DAYS=90

# ─── Dashboard ────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_AUTH_URL=http://localhost:8000
VITE_FARM_API_URL=http://localhost:8001
VITE_FARM_URL=http://localhost:8001
VITE_MARKET_API_URL=http://localhost:8002
VITE_MARKET_URL=http://localhost:8002
VITE_ML_CROP_API_URL=http://localhost:8010
VITE_ML_CROP_URL=http://localhost:8010
VITE_ML_VISION_API_URL=http://localhost:8011
VITE_ML_VISION_URL=http://localhost:8011
VITE_AI_CHAT_API_URL=http://localhost:8012
VITE_AI_CHAT_URL=http://localhost:8012
